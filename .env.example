# Easiest: from the project folder run `npm run setup` (creates .env.local).
# Or copy this file to `.env.local` manually. Never commit `.env.local`.
# See README.md → "Get an API key" and SECURITY.md → BYOK / Vercel.

# --- Public Vercel demo (each visitor uses their own key) ---
# REQUIRE_USER_LLM_KEYS=true
# NEXT_PUBLIC_REQUIRE_USER_LLM_KEYS=true
# Leave LLM_API_KEY empty. See SECURITY.md (BYOK / Vercel).

# --- Optional: allow visitors to override a shared server key ---
# ALLOW_USER_LLM_KEYS=true
# NEXT_PUBLIC_ALLOW_USER_LLM_KEYS=true

# --- Primary model (generates lesson + quiz) ---
# openai | anthropic | google
LLM_PROVIDER=openai
LLM_API_KEY=

# Optional (defaults are kid-friendly / efficient)
# LLM_MODEL=gpt-4o-mini

# --- Verifier model (fact-check + guardrails; runs after each generation) ---
# Uses same values as LLM_* if you omit VERIFIER_LLM_PROVIDER / VERIFIER_LLM_API_KEY.
# Default verifier models are stronger (e.g. gpt-4o, claude-3-5-sonnet) when unset.
VERIFIER_LLM_PROVIDER=
VERIFIER_LLM_API_KEY=
# VERIFIER_LLM_MODEL=gpt-4o
